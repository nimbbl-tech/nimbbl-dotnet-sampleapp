# Nimbbl Merchant Sample App (.NET) - Environment Configuration
#
# Copy this file to .env and update the required values:
#   cp env.example .env
#
# The app auto-loads .env at startup (see Services/EnvLoader.cs).

# Required: API credentials (from Nimbbl Command Center → Developer Settings → Credentials)
NIMBBL_ACCESS_KEY=your_access_key_here
NIMBBL_ACCESS_SECRET=your_access_secret_here

# Optional: Override API base URL (leave empty for production)
# Prod: https://api.nimbbl.tech  |  UAT: https://apipp.nimbbl.tech  |  QA2: https://qa2api.nimbbl.tech
#NIMBBL_API_HOST=

# Optional: Override the Sonic checkout host to match your API env (leave empty for production).
# Must pair with NIMBBL_API_HOST — e.g. for UAT (apipp) use https://sonicpp.nimbbl.tech.
# Prod checkout: https://sonic.nimbbl.tech  |  UAT checkout: https://sonicpp.nimbbl.tech
#NIMBBL_CHECKOUT_HOST=

# Optional (development only): SDK logging
# INFO/WARNING/ERROR logs are always on; NIMBBL_DEBUG_LOGGING toggles DEBUG verbosity only.
# Logs are written to a dated file (e.g., logs/nimbbl_debug_06012026.log).
NIMBBL_DEBUG_LOGGING=false
#NIMBBL_LOG_FILE=logs/nimbbl_debug.log

# Optional: Enable encryption for request payloads (outgoing)
# Incoming webhook/callback decryption is auto-detected (no flag needed).
ENCRYPT_PAYLOAD=false



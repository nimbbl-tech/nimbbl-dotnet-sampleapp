<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MerchantSampleApp</RootNamespace>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="Nimbbl.Sdk.Rest" Version="1.3.5-rc1" />
  </ItemGroup>

  <!-- Exclude ASP.NET Web Forms example files from build (they require .NET Framework) -->
  <ItemGroup>
    <Compile Remove="WebFrameworkExamples\ASPNETWebForms\**\*.aspx.cs" />
    <Content Remove="WebFrameworkExamples\ASPNETWebForms\**\*.aspx" />
  </ItemGroup>

</Project>


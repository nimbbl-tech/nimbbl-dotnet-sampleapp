@model MerchantSampleApp.Models.IndexViewModel
@{
    ViewData["Title"] = "Nimbbl Payment Integration";
}

<div class="container mt-4">
    <h1 class="mb-4">Nimbbl Payment Integration Demo</h1>

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert alert-danger" role="alert">
            @Model.Error
        </div>
    }

    <form method="POST" action="@Url.Action("Index", "Home")">
        <div class="row">
            <div class="col-md-6">
                <h3>Order Details</h3>
                
                <div class="form-group">
                    <label for="amount">Amount (₹)</label>
                    <input type="number" class="form-control" id="amount" name="amount" step="0.01" min="0.01" value="@Model.Amount" required>
                </div>

                <div class="form-group">
                    <label for="currency">Currency</label>
                    <select class="form-control" id="currency" name="currency">
                        <option value="INR" selected>INR</option>
                        <option value="USD">USD</option>
                        <option value="EUR">EUR</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="mode">Checkout Mode</label>
                    <select class="form-control" id="mode" name="mode">
                        <option value="popup" selected>Popup</option>
                        <option value="redirect">Redirect</option>
                    </select>
                </div>
            </div>

            <div class="col-md-6">
                <h3>User Details (Optional)</h3>
                
                <div class="form-group">
                    <label for="name">Name</label>
                    <input type="text" class="form-control" id="name" name="name" value="@Model.Name">
                </div>

                <div class="form-group">
                    <label for="email">Email</label>
                    <input type="email" class="form-control" id="email" name="email" value="@Model.Email">
                </div>

                <div class="form-group">
                    <label for="mobile">Mobile (10 digits)</label>
                    <input type="text" class="form-control" id="mobile" name="mobile" pattern="[0-9]{10}" value="@Model.Mobile" maxlength="10">
                </div>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-12">
                <button type="submit" class="btn btn-primary btn-lg">Pay Now</button>
            </div>
        </div>
    </form>

    @if (!string.IsNullOrEmpty(Model.CheckoutScript))
    {
        <div class="mt-4">
            @Html.Raw(Model.CheckoutScript)
        </div>
    }
</div>

# Nimbbl SDK Configuration
# Copy this file to .env and fill in your actual values

# Required: Your Nimbbl Access Key
# Get this from your Nimbbl merchant dashboard
NIMBBL_ACCESS_KEY=your_access_key_here

# Required: Your Nimbbl Access Secret
# Get this from your Nimbbl merchant dashboard
NIMBBL_ACCESS_SECRET=your_access_secret_here

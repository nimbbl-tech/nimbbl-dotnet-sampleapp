<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NimbblDotnetSampleapp</RootNamespace>
  </PropertyGroup>

  <!-- Use published NuGet package (production release) -->
  <ItemGroup>
    <PackageReference Include="Nimbbl.Sdk.Rest" Version="1.4.0" />
  </ItemGroup>

  <!-- Use local SDK source (uncomment to build against the in-workspace SDK code instead) -->
  <!--
  <ItemGroup>
    <ProjectReference Include="../../server-sdks/nimbbl-dotnet-sdk/Nimbbl.Sdk.Rest/Nimbbl.Sdk.Rest.csproj" />
  </ItemGroup>
    -->

  <!-- Exclude ASP.NET Web Forms example files from build (they require .NET Framework) -->
  <ItemGroup>
    <Compile Remove="WebFrameworkExamples\ASPNETWebForms\**\*.aspx.cs" />
    <Content Remove="WebFrameworkExamples\ASPNETWebForms\**\*.aspx" />
  </ItemGroup>

</Project>


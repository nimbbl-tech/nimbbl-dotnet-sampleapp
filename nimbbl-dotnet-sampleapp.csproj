<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NimbblDotnetSampleapp</RootNamespace>
  </PropertyGroup>

  <!-- Use published NuGet package (default) -->
  <ItemGroup>
    <PackageReference Include="Nimbbl.Sdk.Rest" Version="1.3.5-rc2" />
  </ItemGroup>

  <!-- Use local SDK project (uncomment to use local SDK instead of published package) -->
  <!--
  <ItemGroup>
    <ProjectReference Include="../nimbbl-dotnet-sdk/Nimbbl.Sdk.Rest/Nimbbl.Sdk.Rest.csproj" />
  </ItemGroup>
  -->
  
  <!-- Exclude ASP.NET Web Forms example files from build (they require .NET Framework) -->
  <ItemGroup>
    <Compile Remove="WebFrameworkExamples\ASPNETWebForms\**\*.aspx.cs" />
    <Content Remove="WebFrameworkExamples\ASPNETWebForms\**\*.aspx" />
  </ItemGroup>

</Project>

